# Copy this file to .env.tenantA or .env.tenantB and fill in real values.
# This example file is safe to share. The real ones are not.
PORT=4000
ROUTER_API_URL=http://localhost:3000
ROUTER_API_KEY=put-the-tenant-api-key-here
BRAND_NAME=Your Fictional Business Name
BRAND_PRIMARY_COLOR="#000000"
BRAND_ACCENT_COLOR="#FFFFFF"
BRAND_LOGO=logo.svg
# Accounts: each tenant gets its OWN id and database file (created automatically in server/data/)
TENANT_ID=tenantA
DB_PATH=data/tenantA.db
